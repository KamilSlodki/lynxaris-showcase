flowchart TB
    subgraph frontend["Frontend (Next.js + React)"]
        UI["UI dashboard + modules<br/>sanctions · commodities · routes ·<br/>cases · admin · audit viewer"]
        I18N["i18n multi-locale<br/>idiomas europeos principales"]
        AUTH_NEXT["NextAuth JWT + 2FA TOTP"]
    end

    subgraph api["API Layer (FastAPI)"]
        ROUTER_CHECK["Sanctions Check router<br/>screening individual + batch"]
        ROUTER_DUAL["Commodity Check router<br/>dual-use classification"]
        ROUTER_ROUTES["Routes router<br/>route intelligence + economics"]
        ROUTER_INSURANCE["Insurance router<br/>premium calc + ROI"]
        ROUTER_INTEGRATED["Integrated Check router<br/>orchestrated N1+N2+N3"]
        ROUTER_AUDIT["Audit router<br/>auditable queries"]
        ROUTER_ADMIN["Admin · cases · webhooks"]
    end

    subgraph services["Service Layer (responsabilidad unica por servicio)"]
        N1_MATCH["Matching Engine<br/>ensemble + oracle multi-feature<br/>+ reason codes"]
        N1_FUZZY["Fuzzy + Phonetic<br/>RapidFuzz + Soundex + Metaphone"]
        N1_SCREEN["Screening + Ensemble Matcher"]
        N2_DUAL["Commodity classifier<br/>+ rule engine destination"]
        N3_OPT["Route Optimizer<br/>+ Safe Route Engine<br/>Pareto multi-criteria"]
        N3_RISK["Route Risk + Geo Utils<br/>Haversine + buffer expansion"]
        N3_NLP["Event Classifier<br/>keyword + negation + credibility"]
        N3_OSINT["Geopolitical Sources<br/>ACLED · GDELT · IMB · RSS"]
        N3_ML["Previsión de conflictos<br/>en desarrollo · no disponible"]
        N3_PRED["Route Closure Analysis"]
        INSURANCE["Insurance Premium Calculator<br/>perfiles de carga diferenciados"]
        AGG["Compliance Score<br/>+ Risk Explainability<br/>+ Shipment Assessment"]
        AUTH_SVC["Auth + JWT<br/>+ API Key Rotation<br/>+ 2FA service"]
        AUDIT_SVC["Audit Service<br/>+ Audit Integrity<br/>append-only invariant"]
    end

    subgraph ingest["Ingest Layer (cron + Celery + Redis)"]
        SCHED["Daily Scheduler<br/>delta-tracking + upsert atomico<br/>healthchecks"]
        ING_SANCTIONS["Sanctions Connectors<br/>OFAC · UN · EU · UK · BIS<br/>(fuentes oficiales publicas)"]
        ING_DUAL["Dual-Use Connectors<br/>EU Annex I · ECCN · HS/TARIC"]
        ING_OSINT["OSINT Connectors<br/>conflict + maritime + disaster + RSS"]
    end

    subgraph data["Data Layer"]
        PG[("PostgreSQL<br/>tablas multi-tenant FK<br/>tenant_id en cada tabla core")]
        ALEMBIC["Alembic migrations"]
        AUDIT_LOG[("Audit log append-only<br/>NO UPDATE NI DELETE invariant")]
        REDIS[("Redis<br/>cache + queue")]
        ML_MODELS[("Modelos de previsión<br/>pendientes de entrenar")]
    end

    subgraph observability["Observability"]
        OTEL["OpenTelemetry<br/>traces + custom metrics"]
        SENTRY["Sentry<br/>errors + perf"]
    end

    subgraph cross_cut["Cross-cutting invariants"]
        INV1["Matching determinista auditado"]
        INV2["Oracle scoring + reason codes"]
        INV3["Ingest delta + upsert atomico"]
        INV4["Audit log append-only"]
        INV5["Tenant_id derivado de API key"]
    end

