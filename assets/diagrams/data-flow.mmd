flowchart TB
    subgraph input["Entrada — transaction context"]
        IN_ENTITY["Entity payload<br/>buyer · seller · type · country"]
        IN_PRODUCT["Product payload<br/>description · HS/ECCN candidate · value"]
        IN_GEO["Geo payload<br/>origin · destination · corridor · transport mode"]
        IN_CARGO["Cargo payload<br/>type · value · weight"]
        IN_AUTH["Auth context<br/>API key hash -> tenant_id"]
    end

    subgraph n1["N1 — Sanctions Screening"]
        N1_NORMAL["Normalizer<br/>lowercase · diacritics · transliteration"]
        N1_FUZZY["Fuzzy matcher<br/>RapidFuzz token_set_ratio"]
        N1_PHON["Phonetic matcher<br/>Soundex + Metaphone"]
        N1_ENS["Ensemble combiner<br/>multi-algoritmo configurable"]
        N1_ORACLE["Oracle scoring<br/>multi-feature + reason codes"]
        N1_DECISION["Sanctions decision<br/>AUTO-CLEAR · REVIEW · FLAG · BLOCK<br/>+ matched lists + similarity score"]
    end

    subgraph n2["N2 — Dual-Use Controls"]
        N2_TEXT["Textual fuzzy<br/>descripcion -> codigo regulatorio"]
        N2_CATALOG["Catalog lookup<br/>EU Annex I · ECCN · HS/TARIC"]
        N2_RULE["Destination rule engine<br/>pais x codigo regulatorio"]
        N2_DECISION["Dual-use decision<br/>NO LISTADO · CONTROL · BLOQUEADO<br/>+ classification + restrictions"]
    end

    subgraph n3["N3 — Routes & Geopolitical Risk"]
        N3_GEOM[("Route geometry store<br/>LineString GeoJSON por corredor")]
        N3_EVENTS[("Events store<br/>geo-referenced events<br/>+ severity + timestamp")]
        N3_NLP["NLP event classifier<br/>keyword + negation + credibility"]
        N3_OSINT["OSINT ingest<br/>ACLED · GDELT · IMB · USGS · RSS"]
        N3_GEO["Geo impact engine<br/>Haversine + buffer expansion<br/>+ LineString intersection"]
        N3_ML["Prophet forecaster<br/>conflict-futures por corredor<br/>+ uncertainty bands"]
        N3_BASE[("Corridor baseline<br/>risk + historic timeline")]
        N3_DECISION["Route decision<br/>LOW · MEDIUM · HIGH · CRITICAL<br/>+ alternatives + drivers + ETA conf"]
    end

    subgraph maps["Map rendering — frontend"]
        MAP_BASE["Base map tiles<br/>geo render"]
        MAP_OVERLAY["Risk overlay layer<br/>color by risk_level"]
        MAP_EVENTS["Event markers<br/>severity-coded"]
        MAP_BUFFER["Buffer polygons<br/>impact radius por evento"]
        MAP_VESSEL["Vessel position lookup<br/>AIS optional"]
    end

    subgraph cross["Cross-cutting — Marine Cargo Insurance"]
        INS_PROFILE["Cargo profile selector<br/>risk multipliers diferenciados"]
        INS_PREMIUM["Premium calculator<br/>base + war risk + route risk<br/>+ sanctions + dual-use"]
        INS_ROI["ROI analysis<br/>tradeoff cost / days / risk"]
    end

    subgraph aggregator["Integrated Risk Decision Engine"]
        AGG_COLLECT["Signal collector<br/>recibe outputs de N1+N2+N3+Ins"]
        AGG_WEIGHTS["Tenant risk weights<br/>configurables por tenant"]
        AGG_AGGREGATE["Multi-signal aggregator<br/>score + reason composition"]
        AGG_EXPLAIN["Risk explainability<br/>desglose por factor"]
        AGG_FINAL["Final decision<br/>AUTO-CLEAR · REVIEW · FLAG · BLOCK<br/>+ consolidated reason codes"]
    end

    subgraph audit["Audit & Storage"]
        AUDIT_LOG[("Audit log append-only<br/>NO UPDATE NI DELETE")]
        SCREEN_HIST[("Screening history<br/>per tenant_id")]
    end

    subgraph ui["UI consumers"]
        UI_DASH["Unified Check dashboard<br/>KPIs + case queue"]
